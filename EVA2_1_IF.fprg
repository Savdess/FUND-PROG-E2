    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Edad" type="Integer" array="False" size=""/>
            <output expression="&quot;QUE EDAD TIENES&quot;" newline="True"/>
            <input variable="Edad"/>
            <if expression="Edad&gt;=18">
                <then>
                    <output expression="&quot;Puedes entrar al Antro&quot;" newline="True"/>
                    <output expression="&quot;Felicidades,disfruta tu estancia&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Lo siento,no tienes la edad suficiente,no tienes p&#233;rmitido entrar&quot;" newline="True"/>
                    <output expression="&quot;Vuelve cuando tengas la edad permitida&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
